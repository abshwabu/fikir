{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Health & Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(fikir_http_request_duration_seconds_bucket[5m])) by (le, path))",
          "legendFormat": "{{path}} (p95)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(fikir_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Global p50"
        }
      ],
      "title": "API Latency (p95 per endpoint)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(fikir_http_requests_total[5m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ],
      "title": "HTTP Throughput by Status Code",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "title": "Cache & Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "green", "value": 85 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 10 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "clamp_max((sum(rate(fikir_cache_hits_total[5m])) / (sum(rate(fikir_cache_hits_total[5m])) + sum(rate(fikir_cache_misses_total[5m])) > 0 or 1)) * 100, 100)",
          "legendFormat": "Cache Hit %"
        }
      ],
      "title": "Redis Cache Hit Rate",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 10 },
      "id": 6,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(fikir_swipes_processed_total[5m])) by (direction)",
          "legendFormat": "Swipe {{direction}}"
        }
      ],
      "title": "Swipe Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 10 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(fikir_media_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Image Processing p95"
        }
      ],
      "title": "Image Processing Duration",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 8,
      "title": "Payments & Active Connections",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 17 },
      "id": 9,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(sum(rate(fikir_payments_processed_total{status=\"success\"}[10m])) / (sum(rate(fikir_payments_processed_total[10m])) > 0 or 1)) * 100",
          "legendFormat": "Payment Success %"
        }
      ],
      "title": "Payment Success Rate (Telebirr/Chapa/CBE)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 17 },
      "id": 10,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "fikir_db_pool_acquired_connections",
          "legendFormat": "Acquired"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "fikir_db_pool_idle_connections",
          "legendFormat": "Idle"
        },
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "fikir_db_pool_total_connections",
          "legendFormat": "Total Limit"
        }
      ],
      "title": "PostgreSQL Connection Pool Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 17 },
      "id": 11,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "fikir_ws_active_connections",
          "legendFormat": "WebSocket Clients"
        }
      ],
      "title": "Active Realtime WebSocket Connections",
      "type": "stat"
    }
  ],
