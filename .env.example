# ==========================================
# Fikir Environment Configuration Template
# ==========================================

# Docker Compose Default Files (Loads base + dev override automatically)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Application Environment
APP_ENV=development
APP_PORT=8080
APP_NAME=fikir

# Database (PostgreSQL 16 + PostGIS)
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=5432 # Host exposed port in dev (set to 5433 if host 5432 is in use)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fikir
DB_SSLMODE=disable

# Redis Configuration (Single instance with separated logical databases)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1
REDIS_RATE_LIMIT_DB=2

# MinIO Object Storage
MINIO_ENDPOINT=minio:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
MINIO_BUCKET_ORIGINAL=fikir-media-original
MINIO_BUCKET_PUBLIC=fikir-media-public
MINIO_USE_SSL=false

# Media CDN / Public URL
CDN_BASE_URL=http://localhost/media

# JWT Authentication
JWT_SECRET=fikir-development-jwt-super-secret-key-32chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# SMS Providers (Ethiopian Market / Ethio Telecom / Afromessage)
SMS_PROVIDER=afromessage
SMS_API_KEY=your_afromessage_or_ethio_telecom_api_key
SMS_SENDER_ID=Fikir
SMS_ENDPOINT=https://api.afromessage.com/api/send

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key
FCM_CREDENTIALS_FILE=/app/config/fcm-service-account.json

# Ethiopian Payment Gateways

# 1. Telebirr
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_SHORT_CODE=your_telebirr_short_code
TELEBIRR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"
TELEBIRR_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
TELEBIRR_NOTIFY_URL=http://localhost/api/v1/payments/telebirr/notify

# 2. Chapa
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret
CHAPA_WEBHOOK_URL=http://localhost/api/v1/payments/chapa/webhook

# Dev Tools (pgAdmin)
PGADMIN_EMAIL=admin@fikir.app
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050
